{
  "manifest_version": 3,
  "name": "Polymarket Live News",
  "version": "1.0.0",
  "description": "Live news, Reddit & Telegram updates for any Polymarket prediction market",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://polymarket.com/*",
    "https://www.reddit.com/*",
    "https://api.telegram.org/*",
    "https://newsapi.org/*",
    "https://news.google.com/*",
    "https://rss.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://polymarket.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
