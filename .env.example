# ─── Telegram API credentials ───────────────────────────────────────────────
# Get these from https://my.telegram.org → API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# Your Telegram phone number (international format, e.g. +12025550123)
TELEGRAM_PHONE=+12025550123

# Session file name (no extension – stored in ./data/)
TELEGRAM_SESSION_NAME=beirut_monitor

# ─── Alert destination ───────────────────────────────────────────────────────
# Your personal Telegram chat/user ID for incoming alerts
# Find your ID by messaging @userinfobot on Telegram
ALERT_TELEGRAM_CHAT_ID=123456789

# ─── Dashboard ───────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Optional: basic-auth user/password for the dashboard (leave blank = no auth)
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default). To switch to Postgres: postgresql+asyncpg://user:pass@host/db
DB_URL=sqlite+aiosqlite:///./data/incidents.db

# ─── Translation ─────────────────────────────────────────────────────────────
# Supported providers: google, deepl, libre
TRANSLATION_PROVIDER=google

# DeepL API key (only used when TRANSLATION_PROVIDER=deepl)
DEEPL_API_KEY=

# LibreTranslate instance URL (only used when TRANSLATION_PROVIDER=libre)
LIBRE_TRANSLATE_URL=http://localhost:5000

# ─── Detection thresholds ────────────────────────────────────────────────────
# Score at which EARLY WARNING fires (single-message, intentionally low)
EARLY_WARNING_THRESHOLD=40

# Score at which CONFIRMATION ALERT fires (higher bar, multi-source/media)
CONFIRMATION_THRESHOLD=70

# Incident clustering window: messages within this many seconds are grouped
INCIDENT_CLUSTER_WINDOW_SECONDS=1800

# ─── Webhook notification ────────────────────────────────────────────────────
# POST JSON payload to this URL on each alert (leave blank to disable)
WEBHOOK_URL=

# Optional Bearer token sent in Authorization header for webhook
WEBHOOK_SECRET=

# ─── Email notification ──────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# ─── Polymarket trading ──────────────────────────────────────────────────────
# From Polymarket → Settings → API Keys
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Your Polygon wallet private key (hex, with or without 0x prefix)
# This signs CLOB orders – never share this, never commit it
POLYMARKET_PRIVATE_KEY=

# Fixed USDC amount to bet per early-warning signal
POLYMARKET_TRADE_AMOUNT=100

# Set to false to run the system in monitor-only mode without placing bets
POLYMARKET_TRADING_ENABLED=true

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
